{
  "manifest_version": 3,
  "name": "BCPS Logbook Bulk Approver",
  "version": "1.1",
  "description": "BCPS E-Logbook supervisor approval app, with an on-page floating control panel. Developed by Abdullah Al Maruf | 01770578663",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://eportal.bcps.edu.bd/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BCPS Logbook Bulk Approver — click to show/hide panel",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://eportal.bcps.edu.bd/supervisor/logbook*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo-popup.png"],
      "matches": ["https://eportal.bcps.edu.bd/*"]
    }
  ]
}
